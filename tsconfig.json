{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "ES2020",
    "moduleResolution": "bundler",
    "strict":           true,
    "noImplicitAny":    true,
    "strictNullChecks": true,
    "lib":              ["ES2020", "DOM", "DOM.Iterable"],
    "outDir":           "./docs/assets",
    "rootDir":          "./src",
    "declaration":      true,
    "sourceMap":        true,
    "skipLibCheck":     true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "docs", "dist"]
}
